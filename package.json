{
  "name": "climate-shelter-iot",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "wokwi:start": "node scripts/wokwi-start.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:cloud": "node scripts/cloud.mjs dev",
    "build:cloud": "node scripts/cloud.mjs build",
    "start:cloud": "node scripts/cloud.mjs start",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p services/mqtt-bridge/tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "bridge:dev": "npm run dev --workspace @climate-shelter/mqtt-bridge",
    "bridge:build": "npm run build --workspace @climate-shelter/mqtt-bridge",
    "bridge:start": "npm run start --workspace @climate-shelter/mqtt-bridge",
    "test:http": "node scripts/smoke.mjs"
  },
  "workspaces": [
    "services/mqtt-bridge"
  ],
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
