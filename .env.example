# Demo lokal tanpa kredensial; false WAJIB untuk data/perangkat nyata.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opsional: fallback untuk project yang masih memakai legacy anon.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_ORIGIN=http://localhost:3000
# Server-only: diperlukan HTTP IoT dan undangan pengguna.
# Jangan beri awalan NEXT_PUBLIC_ dan jangan simpan di browser/firmware.
SUPABASE_SERVICE_ROLE_KEY=
# Disarankan untuk project baru (menggantikan legacy service_role di atas).
SUPABASE_SECRET_KEY=

# Simulator lokal (bukan perangkat produksi).
WOKWI_LOCAL_ENABLED=false
WOKWI_INGEST_TOKEN=
# true membuka Cloudflare Tunnel untuk POST telemetry ketika npm run dev dijalankan.
# Aktifkan hanya setelah memilih penggunaan tunnel sementara.
WOKWI_TUNNEL_AUTO_START=false

